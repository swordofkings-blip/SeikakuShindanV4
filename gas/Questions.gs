/**
 * 質問IDから質問オブジェクトを取得し、画像URLを付与して返す。
 * @param {string} id 質問ID
 * @returns {Object|null}
 */
function getQuestionById(id) {
  for (var i = 0; i < QUESTION_POOL.length; i++) {
    if (QUESTION_POOL[i].id === id) {
      return attachImageUrl_(QUESTION_POOL[i]);
    }
  }
  return null;
}

/**
 * 序盤の固定質問（Q1〜Q5）を返す。
 * @returns {Array<Object>}
 */
function getFixedQuestions() {
  var list = [];
  for (var i = 0; i < QUESTION_POOL.length; i++) {
    if (QUESTION_POOL[i].category === 'FIXED') {
      list.push(attachImageUrl_(QUESTION_POOL[i]));
    }
  }
  return list;
}

/**
 * 指定軸・カテゴリの未出題質問を返す。
 * @param {string} category 'MBTI_ADAPTIVE' | 'MBTI_BALANCE' | 'BIG5_ADAPTIVE'
 * @param {string} axis 例: 'E/I', 'BIG5_N'
 * @param {Object} askedMap 出題済みIDマップ { [id]: true }
 * @returns {Array<Object>}
 */
function getUnaskedQuestions(category, axis, askedMap) {
  var list = [];
  for (var i = 0; i < QUESTION_POOL.length; i++) {
    var q = QUESTION_POOL[i];
    if (q.category === category && q.axis === axis && !askedMap[q.id]) {
      list.push(attachImageUrl_(q));
    }
  }
  return list;
}

/**
 * 画像URLを付与したクローンオブジェクトを返す（GAS ペイロード肥大化を避けるため外部URL参照）。
 * @param {Object} q
 * @returns {Object}
 */
function attachImageUrl_(q) {
  return {
    id: q.id,
    category: q.category,
    axis: q.axis,
    sceneTag: q.sceneTag,
    question: q.question,
    templates: q.templates,
    imageUrl: APP_CONFIG.IMAGE_PATH_PREFIX + q.id + '.webp'
  };
}
